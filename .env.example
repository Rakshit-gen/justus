# Copy this file to .env.local and fill in your values

PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/chatme?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Web push notifications. Generate keys once with:
#   npx web-push generate-vapid-keys
# Then paste the public key into VAPID_PUBLIC_KEY and the private key into VAPID_PRIVATE_KEY.
# Leave empty to disable push (the app still works, just no OS-level notifications).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
